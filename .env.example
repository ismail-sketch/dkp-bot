# ==== ОБЯЗАТЕЛЬНО: токен бота от @BotFather ====
# Пример: BOT_TOKEN=1234567890:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw
BOT_TOKEN=

# ==== НЕ ОБЯЗАТЕЛЬНО (можно не трогать) ====
# Локально — SQLite. На сервере заменить на PostgreSQL.
DATABASE_URL=sqlite:///data/app.db

# Ключ шифрования паспортных данных.
# Оставьте ПУСТЫМ — при первом запуске создастся автоматически в data/secret.key
ENCRYPTION_KEY=

# Ваш Telegram ID для уведомлений об ошибках (можно оставить пустым)
ADMIN_ID=

# INFO — обычный режим, DEBUG — подробный
LOG_LEVEL=INFO
